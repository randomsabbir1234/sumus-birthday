
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title> Happiest birthday SUMU🎀🌸</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #020305;
  overflow: hidden;
  font-family: Georgia, serif;
}

.intro {
  height: 100vh;
  height: 100dvh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 75%,
    #191323 0%, #07070d 38%, #020305 75%);
}

.ground {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 12%;
  background: linear-gradient(transparent, #07120b);
}

.flowers {
  position: absolute;
  bottom: 7%;
  left: 0;
  width: 100%;
  height: 70%;
}

.flower {
  position: absolute;
  bottom: 0;
  width: var(--w);
  height: var(--h);
  transform-origin: bottom center;
  transform: scaleY(0);
  animation: grow 1.7s cubic-bezier(.2,.8,.3,1) forwards;
  animation-delay: var(--delay);
}

.stem {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 2px;
  height: 78%;
  transform: translateX(-50%);
  background: linear-gradient(to top, #142a16, #43843b);
  border-radius: 100%;
}

.leaf {
  position: absolute;
  width: 15px;
  height: 7px;
  background: #39733b;
  border-radius: 100% 0 100% 0;
}

.leaf.left {
  left: 50%;
  bottom: 28%;
  transform: rotate(20deg);
}

.leaf.right {
  right: 50%;
  bottom: 43%;
  transform: rotate(200deg);
}

.bloom {
  position: absolute;
  top: 0;
  left: 50%;
  width: 32px;
  height: 32px;
  transform: translate(-50%, -12%);
  animation: sway 3s ease-in-out infinite alternate;
  animation-delay: var(--delay);
}

.petal {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 11px;
  height: 17px;
  margin-left: -5.5px;
  margin-top: -15px;
  border-radius: 50% 50% 40% 40%;
  background: var(--color);
  transform-origin: 50% 15px;
  transform: rotate(var(--angle));
  box-shadow: 0 0 7px color-mix(in srgb, var(--color), transparent 35%);
}

.center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9px;
  height: 9px;
  background: #f9d875;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 12px #ffce69;
}

.message {
  position: absolute;
  top: 66%;
  left: 50%;
  width: 90%;
  text-align: center;
  transform: translate(-50%, -50%);
  color: #fff2d9;
  font-size: clamp(25px, 7vw, 42px);
  font-style: italic;
  letter-spacing: 3px;
  opacity: 0;
  animation: appear 2s ease forwards;
  animation-delay: 3.5s;
  text-shadow: 0 0 10px #ffc5df, 0 0 30px #ff6ab6;
  z-index: 5;
}

.glow {
  position: absolute;
  left: 50%;
  top: 65%;
  width: 180px;
  height: 100px;
  transform: translate(-50%, -50%);
  background: #e89aca;
  filter: blur(65px);
  opacity: 0;
  animation: glowIn 2s ease forwards;
  animation-delay: 3s;
}

@keyframes grow {
  to { transform: scaleY(1); }
}

@keyframes sway {
  from { rotate: -5deg; }
  to { rotate: 5deg; }
}

@keyframes appear {
  0% { opacity: 0; letter-spacing: 12px; }
  100% { opacity: 1; letter-spacing: 3px; }
}

@keyframes glowIn {
  to { opacity: .25; }
}

</style>
</head>

<body>
<div class="intro">
  <div class="glow"></div>
  <div class="flowers" id="flowers"></div>
  <div class="ground"></div>
  <div class="message">My Love ♡</div>
</div>

<script>
const garden = document.getElementById("flowers");

const colors = [
  "#ff8eb7",
  "#ffca62",
  "#f5a5e8",
  "#fff0a8",
  "#e98ba1",
  "#a9a2ff",
  "#ffb7d5"
];

for (let i = 0; i < 48; i++) {
  const flower = document.createElement("div");
  flower.className = "flower";

  const x = (i / 47) * 100;
  const height = 65 + Math.random() * 180;
  const width = 20 + Math.random() * 20;
  const delay = 0.2 + Math.random() * 2.3;
  const color = colors[Math.floor(Math.random() * colors.length)];

  flower.style.left = x + "%";
  flower.style.setProperty("--h", height + "px");
  flower.style.setProperty("--w", width + "px");
  flower.style.setProperty("--delay", delay + "s");

  const stem = document.createElement("div");
  stem.className = "stem";
  flower.appendChild(stem);

  const leaf1 = document.createElement("div");
  leaf1.className = "leaf left";
  flower.appendChild(leaf1);

  const leaf2 = document.createElement("div");
  leaf2.className = "leaf right";
  flower.appendChild(leaf2);

  const bloom = document.createElement("div");
  bloom.className = "bloom";

  for (let p = 0; p < 8; p++) {
    const petal = document.createElement("div");
    petal.className = "petal";
    petal.style.setProperty("--angle", (p * 45) + "deg");
    petal.style.setProperty("--color", color);
    bloom.appendChild(petal);
  }

  const center = document.createElement("div");
  center.className = "center";
  bloom.appendChild(center);

  flower.appendChild(bloom);
  garden.appendChild(flower);
}
</script>
</body>
</html>
